{
  "name": "consumer-tests",
  "private": true,
  "version": "1.0.0",
  "description": "Just tests that bundling only pulls in React when required and that Typescript definitions work in all module resolutions",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "for f in typescript-*; do vite build \"$f\" || exit; done",
    "typecheck:ts-default": "tsc --ignoreConfig --types vite/client --noEmit typescript-moduleresolution-default/src/main.ts",
    "typecheck:ts-react-default": "tsc --ignoreConfig --types vite/client --noEmit --allowImportingTsExtensions  --jsx react typescript-react-moduleresolution-default/src/main.tsx",
    "typecheck:ts-nodenext": "tsc --ignoreConfig --types vite/client --noEmit --allowImportingTsExtensions --module nodenext --moduleResolution nodenext typescript-moduleresolution-nodenext/src/main.ts",
    "typecheck": "run-p typecheck:*",
    "pretest": "../scripts/workaround-for-tsc-symlink-issue.sh",
    "test": "run-s typecheck build && ! (grep -i react typescript-moduleresolution-*/dist/assets/*)"
  },
  "dependencies": {
    "@fatso83/retry-dynamic-import": "file:../pkg",
    "npm-run-all2": "^8.0.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  },
  "volta": {
    "extends": "../package.json"
  }
}
